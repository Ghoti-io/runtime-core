# 07 root through a copy
# defect: the root is reported through a copy, so a moving collector's rewrite is lost
# caught by: the roots test: the owner reads the moved word
# test: testHandles
# filter: Handles.AValueHeldThroughTheTable*
# arm: release
#
# The patch applies with fuzz 0; tools/check-planted.sh names one that no longer does.
--- a/src/b/handles.c
+++ b/src/b/handles.c
@@ -325,7 +325,8 @@
   lock(t);
   for (uint32_t i = p->owned_head; i != GRCORE_HANDLE_NONE;
       i = t->entries[i].owned_next) {
-    visitor->slot(visitor->user, &t->entries[i].value);
+    uint64_t copy = t->entries[i].value; /* planted */
+    visitor->slot(visitor->user, &copy);
   }
   unlock(t);
 }
